:root{color-scheme:dark;--bg:#090b10;--cd:#151923;--ln:#29303d;--tx:#f4f2ed;--mu:#9ba3b2;--ac:#d8b77a;--gn:#8fc9aa;--glass:#111722;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{background:radial-gradient(ellipse at 50% -20%,#202a3b 0%,var(--bg) 55%);color:var(--tx);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;letter-spacing:.01em}
.tab{display:none;flex:1;min-height:0;overflow:auto}.tab.on{display:flex;flex-direction:column}
nav{display:flex;border-top:1px solid #ffffff12;background:#0d1119ed;backdrop-filter:blur(18px);padding-bottom:env(safe-area-inset-bottom,0px);box-shadow:0 -10px 30px #0003}
nav button{flex:1;background:none;border:0;color:var(--mu);padding:10px 0;font:inherit;font-size:12px}
nav button.on{color:var(--ac)}nav i{display:block;font-style:normal;font-size:20px;margin-bottom:2px}nav button{padding:11px 0 9px}
button,select{font:inherit;color:var(--tx);cursor:pointer}
/* CAMERA */
.vf{position:relative;flex:1;min-height:300px;background:#05070b;overflow:hidden;max-width:620px;width:100%;margin:10px auto 0;border:1px solid #ffffff12;border-radius:22px;box-shadow:0 18px 55px #0008;touch-action:none;overscroll-behavior:contain;user-select:none;-webkit-user-select:none}
.vf video,.vf canvas.fx,.vf canvas.demo{transform-origin:0 0;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .25s}
#ov{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.focus-ring{position:absolute;width:54px;height:54px;border:1.5px solid #f2d69b;border-radius:50%;z-index:4;pointer-events:none;display:none;transform:translate(-50%,-50%);filter:drop-shadow(0 2px 5px #000);animation:focusPulse .75s ease-out}
.focus-ring:before,.focus-ring:after{content:"";position:absolute;background:#f2d69b}
.focus-ring:before{width:1px;height:12px;left:50%;top:-7px}.focus-ring:after{height:1px;width:12px;top:50%;left:-7px}
@keyframes focusPulse{0%{opacity:.4;scale:.78}35%{opacity:1;scale:1.08}100%{opacity:.9;scale:1}}
@media (pointer:fine){.focus-ring{border-radius:10px}}
.top{position:absolute;top:8px;left:10px;right:10px;display:flex;justify-content:space-between;align-items:center;z-index:3}
.pill{background:#111722bd;border:1px solid #ffffff1b;border-radius:20px;padding:7px 12px;font-size:12px;backdrop-filter:blur(14px);box-shadow:0 4px 16px #0004}
.sug{position:absolute;left:50%;top:52px;transform:translateX(-50%);background:#d8b77ae8;color:#17130b;font-weight:700;border-radius:20px;padding:7px 15px;font-size:12px;z-index:3;white-space:nowrap;transition:.2s;box-shadow:0 5px 20px #0005}
.sug.ok{background:#34d399cc}
.sugbtn{position:absolute;left:50%;top:84px;transform:translateX(-50%);display:flex;gap:8px;z-index:3}
.sugbtn button{border:0;border-radius:18px;padding:8px 18px;font-weight:700;font-size:13px;background:#34d399;color:#04210f}
.sugbtn button.no{background:#000a;color:#fff;font-weight:500;backdrop-filter:blur(8px)}
.lens{position:absolute;left:0;right:0;bottom:8px;display:flex;justify-content:center;gap:8px;z-index:3}
.lens button{width:38px;height:38px;border-radius:50%;background:#0009;border:1px solid #fff3;font-size:12px}
.lens button.on{color:var(--ac);border-color:var(--ac);transform:scale(1.12)}
.ctrl{max-width:620px;width:100%;margin:0 auto;background:linear-gradient(180deg,#090b10,#111722);padding:12px 18px 16px;border-radius:0 0 22px 22px}
.modes{display:flex;justify-content:center;gap:20px;color:var(--mu);margin-bottom:8px}
.modes b{font-weight:500;cursor:pointer;padding:2px 0}.modes b.on{color:var(--ac);border-bottom:2px solid var(--ac)}
.shutrow{display:flex;align-items:center;justify-content:space-between}
.thumb{width:50px;height:50px;border-radius:14px;background:#222 center/cover;border:1px solid #ffffff30;box-shadow:0 5px 18px #0005}
.shut{width:72px;height:72px;border-radius:50%;border:2px solid #f4e6c8;background:linear-gradient(145deg,#d8b77a,#f3e1b8);padding:5px;box-shadow:0 0 0 5px #d8b77a22,0 8px 25px #0007}.shut i{display:block;width:100%;height:100%;border-radius:50%;background:#fffaf0}.shut:active i{transform:scale(.88)}
.flip{width:48px;height:48px;border-radius:50%;background:#202735;border:1px solid #ffffff18;font-size:20px}
.pro{display:none;background:#000;border-top:1px solid var(--ln);padding:8px 14px;max-width:560px;margin:0 auto;width:100%}.pro.on{display:block}
.pro .sl{display:grid;grid-template-columns:62px 1fr 56px;gap:8px;align-items:center;font:11px ui-monospace,monospace;color:var(--mu);margin:3px 0}
.pro .sl output{color:var(--gn);text-align:right}
#hist{width:100%;height:42px;background:#0a0a0c;border:1px solid var(--ln);border-radius:6px;margin-bottom:4px}
input[type=range]{width:100%;accent-color:var(--ac)}
/* GALLERY */
.gh{padding:16px 16px;display:flex;gap:8px;align-items:center;position:sticky;top:0;background:#0b0f17ed;backdrop-filter:blur(16px);z-index:2;border-bottom:1px solid #ffffff10}
.gh h2{margin:0;font-size:21px;flex:1;font-weight:650;letter-spacing:-.03em}
.gb{background:#1a2230;border:1px solid #ffffff16;border-radius:20px;padding:7px 12px;font-size:12px;color:#e9e3d7}
.day{padding:14px 16px 7px;color:var(--ac);font-size:12px;font-weight:650;letter-spacing:.04em}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:5px;padding:0 8px 10px}
.grid div{aspect-ratio:1;background:#222 center/cover;position:relative;cursor:pointer;border-radius:9px;overflow:hidden;box-shadow:0 4px 14px #0004}
.grid span{position:absolute;right:4px;bottom:4px;font-size:10px;background:#0009;border-radius:4px;padding:1px 4px}
.empty{padding:60px 20px;text-align:center;color:var(--mu)}
.viewer{position:fixed;inset:0;background:#050506f5;z-index:20;display:none;flex-direction:column;align-items:center;justify-content:center;padding:18px}
.viewer.on{display:flex}
.viewer img{max-width:100%;max-height:calc(100% - 110px);object-fit:contain}
.viewer .vbar{width:min(100%,560px);display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}
.viewer .vbar .btn{padding:10px 16px}
.viewer .vclose{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:14px;border:0;border-radius:50%;width:40px;height:40px;background:#25262b;color:white;font-size:22px}
/* STUDIO */
.st{display:grid;grid-template-columns:minmax(0,1fr) 300px;flex:1;min-height:0}
@media(max-width:780px){.st{grid-template-columns:1fr;grid-template-rows:minmax(220px,40%) minmax(0,1fr)}.pnl{border-left:0;border-top:1px solid #ffffff14;padding:13px 14px 24px}.cv{min-height:220px}.pnl .rw:first-child{position:sticky;top:-13px;z-index:4;background:#151b27ed;padding:7px 0 10px;margin-top:-7px;backdrop-filter:blur(12px)}.pnl .sl{grid-template-columns:76px 1fr 36px;margin:7px 0}.pnl input[type=range]{min-height:26px}.tag{top:10px}}
.cv{position:relative;background:#050506;display:grid;place-items:center;overflow:hidden;min-height:0}
.cv .stk{position:relative;max-width:100%;max-height:100%}
.cv canvas{display:block;max-width:100%;max-height:100%}
#cvO{position:absolute;inset:0;width:100%;height:100%}
.tag{position:absolute;top:8px;background:#000a;border-radius:4px;padding:2px 8px;font-size:11px}
.pnl{background:linear-gradient(180deg,#151b27,#10151e);border-left:1px solid #ffffff12;overflow:auto;padding:16px 15px}
.pnl h4{margin:17px 0 7px;font-size:10px;letter-spacing:.15em;color:var(--ac);text-transform:uppercase}
.pnl .sl{display:grid;grid-template-columns:78px 1fr 34px;gap:6px;align-items:center;font-size:12px;color:#c5c7cf;margin:2px 0}
.pnl .sl output{text-align:right;color:var(--ac);font-size:11px}
.pnl input[type=range]{accent-color:#8ab4ff}
.btn{background:#202838;border:1px solid #ffffff18;border-radius:11px;padding:9px 12px;font-size:12px;color:#eee9df;transition:.18s}.btn.p{background:linear-gradient(135deg,#d8b77a,#f0d8a8);color:#1c170d;border-color:#e6c98f;font-weight:750;box-shadow:0 5px 16px #d8b77a22}
.rw{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
.pnl input[type=text],.pnl input[type=password],.pnl textarea{width:100%;background:#0b1019;border:1px solid #ffffff1c;border-radius:11px;color:var(--tx);padding:10px;font:inherit;font-size:12px;margin:4px 0}
.note{font-size:11px;color:var(--mu)}
.vf video,.vf canvas.demo{transition:none;transform-origin:0 0;will-change:transform}
.pill.on{background:var(--ac);color:#190a00;font-weight:700}
#bAI{padding:8px 14px}
@media(orientation:landscape) and (max-height:620px){
#t-cam.on{flex-direction:row}.vf{max-width:none;margin:0}
.top{flex-direction:column;align-items:flex-start;right:auto;gap:8px}.sug{top:8px}.sugbtn{top:44px}
.lens{left:auto;right:10px;top:0;bottom:0;flex-direction:column-reverse;justify-content:center}
.ctrl{max-width:none;width:150px;margin:0;display:flex;flex-direction:column;justify-content:center;gap:12px;padding:8px}
.modes{flex-direction:column;align-items:center;gap:10px;margin:0}.shutrow{flex-direction:column;gap:14px}
.pro{max-width:230px;margin:0;border-top:0;border-left:1px solid var(--ln);order:2;overflow:auto}
}

/* Studio controls: compact rows; expand only the selected adjustment */
.pnl .sl{grid-template-columns:1fr 42px;gap:7px;padding:6px 8px;background:#0e141e;border:1px solid #ffffff0c;border-radius:9px;margin:5px 0}
.pnl .sl>span{grid-column:1;grid-row:1;font-weight:550}.pnl .sl>output{grid-column:2;grid-row:1}.pnl .sl>input{grid-column:1 / -1;grid-row:2;display:none;margin:2px 0 0}
.pnl .sl.open>input{display:block}.pnl .sl:not(.open)>input{display:none}

/* ===== AI ===== */
.btn:disabled{opacity:.4;cursor:default}
.chips{display:flex;gap:6px;overflow-x:auto;padding:2px 0 6px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:1px solid #ffffff1c;background:#202838;color:#eee9df;border-radius:16px;padding:6px 12px;font-size:12px}.chip.on{background:var(--ac);color:#1c170d;font-weight:700;border-color:var(--ac)}.chip small{opacity:.6}
.sugbtn{width:max-content;max-width:94%}.sugbtn button{white-space:nowrap}
.scene{position:absolute;left:50%;bottom:54px;transform:translateX(-50%);width:max-content;max-width:92%;display:none;align-items:center;gap:6px;background:#111722d9;border:1px solid #ffffff1b;border-radius:18px;padding:5px 6px 5px 12px;font-size:12px;z-index:3;backdrop-filter:blur(14px);box-shadow:0 4px 16px #0004}
.scene button{border:0;border-radius:14px;padding:5px 10px;font-size:12px;background:#202838;color:#eee9df;flex:none}.scene #sceneGo{background:var(--ac);color:#1c170d;font-weight:700}
.gsearch{padding:10px 14px 0}.gsearch input{width:100%;background:#0b1019;border:1px solid #ffffff1c;border-radius:20px;color:var(--tx);padding:9px 14px;font:inherit;font-size:13px}
#gTags{padding:8px 14px 0}
.grid span.ai{left:4px;top:4px;right:auto;bottom:auto;background:#d8b77aee;color:#1c170d;font-weight:700}
.aiOut{background:#0b1019;border:1px solid #ffffff14;border-radius:12px;padding:10px;font-size:12px;margin:6px 0}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin:6px 0}.tags span{background:#202838;border-radius:12px;padding:2px 9px;font-size:11px;color:var(--ac)}
.aipage{max-width:640px;width:100%;margin:0 auto;padding:16px 14px 28px}
.aipage h2{margin:4px 0 12px;font-size:21px;font-weight:650;letter-spacing:-.03em}
.card{background:linear-gradient(180deg,#151b27,#10151e);border:1px solid #ffffff12;border-radius:16px;padding:14px;margin-bottom:12px}
.card h3{margin:0 0 8px;font-size:11px;letter-spacing:.14em;color:var(--ac);text-transform:uppercase}
.aipage input[type=text],.aipage input[type=password],.aipage textarea,.aipage select{width:100%;background:#0b1019;border:1px solid #ffffff1c;border-radius:11px;color:var(--tx);padding:10px;font:inherit;font-size:13px;margin:4px 0}
.chk{display:flex;gap:8px;align-items:flex-start;font-size:12px;color:#c5c7cf;margin:6px 0}.chk input{margin-top:3px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.aipage ul{margin:4px 0;padding-left:18px;list-style:none}.aipage li{font-size:12px;color:#c5c7cf;margin:3px 0;margin-left:-18px}

/* Pro controls */
.pro{max-width:620px;padding:10px 14px 12px;background:linear-gradient(180deg,#080b10,#111722)}
.pro-head{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:.13em;color:var(--ac);margin-bottom:8px}
.pro-values{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.pro-param{display:flex;align-items:center;justify-content:space-between;gap:5px;background:#171e29;border:1px solid #ffffff16;border-radius:10px;padding:8px 10px;text-align:left;min-width:0}
.pro-param small{font-size:10px;color:var(--mu)}.pro-param b{font:600 13px ui-monospace,monospace;color:#f0d8a8}
.pro-param.on{border-color:var(--ac);background:#29251d}
.pro-adjust{margin-top:8px;padding:9px 10px;background:#0d131d;border:1px solid #ffffff12;border-radius:12px}
.pro-adjust-title{display:flex;justify-content:space-between;align-items:center;font-size:12px;margin-bottom:4px}.pro-adjust-title output{color:var(--ac);font:600 13px ui-monospace,monospace}
.pro-adjust .sl{display:block;margin:0}.pro-adjust .sl[hidden]{display:none}.pro-adjust .sl input{width:100%;margin:4px 0}.pro-adjust .sl output{display:none}.pro-hint{font-size:10px;color:var(--mu);margin-top:3px}
#hist{height:32px;margin:7px 0 0}
.gal-tools{padding:8px 14px 2px}.gal-filters{display:flex;gap:6px;overflow:auto}.gal-selection{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12px;color:var(--ac)}
.grid div.selected{outline:2px solid var(--ac);outline-offset:-2px}.grid div .selmark{position:absolute;left:5px;top:5px;background:var(--ac);color:#1c170d;border-radius:50%;width:22px;height:22px;display:grid;place-items:center;font-weight:800}
.viewer .vbar{flex-wrap:wrap;justify-content:center}.viewer .vbar #vInfo{flex:1 0 100%;text-align:center}.viewer .vbar .btn{padding:9px 12px}
@media(max-width:780px){.gh{flex-wrap:wrap}.gh h2{flex:1 0 100%}.gh .gb{flex:1}.pro{padding:8px 10px}.pro-values{grid-template-columns:repeat(3,minmax(0,1fr))}.pro-param{padding:8px}.viewer{padding:14px}.viewer .vbar{gap:5px}}
@media(orientation:landscape) and (max-height:620px){.pro{max-width:250px}.pro-values{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* Camera upgrades: looks, settings, theme */
.look-row{display:flex;gap:6px;overflow-x:auto;padding:3px 0 10px;scrollbar-width:none}
.look-row::-webkit-scrollbar{display:none}
.look-chip{flex:none;border:1px solid #ffffff20;background:#202838;color:#d9dce3;border-radius:18px;padding:6px 11px;font-size:11px}
.look-chip.on{background:var(--ac);color:#1b160c;border-color:var(--ac);font-weight:700}
.settings-overlay{position:fixed;inset:0;z-index:40;background:#000b;display:none;align-items:flex-end;justify-content:center;padding:12px}
.settings-overlay.on{display:flex}
.settings-panel{width:min(100%,560px);max-height:88%;overflow:auto;background:#151b27;border:1px solid #ffffff24;border-radius:20px;padding:16px;box-shadow:0 18px 60px #0009}
.settings-head{display:flex;align-items:center;justify-content:space-between;font-size:17px;margin-bottom:12px}
.settings-panel h4{margin:15px 0 6px;color:var(--ac);font-size:10px;letter-spacing:.14em;text-transform:uppercase}
.setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #ffffff12;font-size:13px}
.setting-row select{max-width:58%;background:#0b1019;border:1px solid #ffffff25;border-radius:9px;padding:8px;color:var(--tx)}
.setting-row input{width:18px;height:18px;accent-color:var(--ac)}
.setting-disabled{font-size:11px;color:#9ba3b2;text-align:right}
.setting-note{font-size:11px;color:#9ba3b2;padding:8px 0;line-height:1.5}
body[data-theme="light"]{--bg:#eef1f5;--cd:#fff;--ln:#d8dee8;--tx:#18202b;--mu:#657184;--glass:#e7ebf2;background:linear-gradient(180deg,#f8fafc,#e9edf3);color:var(--tx)}
body[data-theme="light"] nav{background:#ffffffed;border-color:#d8dee8}
body[data-theme="light"] .ctrl,body[data-theme="light"] .pnl,body[data-theme="light"] .card,body[data-theme="light"] .settings-panel{background:#fff;color:#18202b}
body[data-theme="light"] .gh{background:#ffffffed;border-color:#d8dee8}
body[data-theme="light"] .btn,body[data-theme="light"] .chip,body[data-theme="light"] .look-chip{background:#e8edf4;color:#18202b;border-color:#d5dce7}
body[data-theme="light"] .pro,body[data-theme="light"] .pro-adjust{background:#e9edf3;color:#18202b}
body[data-theme="light"] .pro-param{background:#fff;color:#18202b;border-color:#d5dce7}
body[data-theme="light"] .pro-param.on{background:#f7ecd5;border-color:#b28b45}
body[data-theme="light"] .pnl .sl,body[data-theme="light"] .aipage input,body[data-theme="light"] .aipage textarea,body[data-theme="light"] .aipage select{background:#f2f5f9;color:#18202b;border-color:#d5dce7}
body[data-theme="light"] .settings-panel .setting-row select{background:#f2f5f9;color:#18202b}
@media(max-width:780px){.look-row{padding-bottom:8px}.settings-overlay{padding:0}.settings-panel{border-radius:20px 20px 0 0;max-height:90%;padding-bottom:calc(16px + env(safe-area-inset-bottom,0px))}}
@media(orientation:landscape) and (max-height:620px){.look-row{max-width:620px;margin:auto}}
